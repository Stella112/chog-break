pragma solidity ^0.8.24;

import {Test, stdJson} from "forge-std/Test.sol";
import {IERC721} from "@openzeppelin/contracts/token/ERC721/IERC721.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {IERC20Errors, IERC721Errors} from "@openzeppelin/contracts/interfaces/draft-IERC6093.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {ChogBreakRegistry} from "../src/ChogBreakRegistry.sol";
import {MockChogs, MockChogToken, ReentrantToken, IRecord} from "./mocks/Mocks.sol";

contract ChogBreakRegistryTest is Test {
    using stdJson for string;

    address constant REAL_CHOG_GENESIS = 0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763;
    address constant DEAD = 0x000000000000000000000000000000000000dEaD;
    uint256 constant FEE = 100e18;
    uint256 constant MAX_FEE = 10_000e18;

    MockChogs nft;
    MockChogToken token;
    ChogBreakRegistry reg;

    address owner = makeAddr("owner");
    address prize = makeAddr("prize");
    address alice = makeAddr("alice"); // splicer
    address bob = makeAddr("bob"); // splicer 2
    address holderA = makeAddr("holderA");
    address holderB = makeAddr("holderB");

    event PairDiscovered(bytes32 indexed pairKey, uint256 indexed lo, uint256 indexed hi, address discoverer);
    event SpliceRecorded(
        address indexed splicer,
        address indexed payer,
        uint256 lo,
        uint256 hi,
        bytes32 indexed pairKey,
        address ownerLo,
        address ownerHi,
        uint256 fee,
        uint256 shareLo,
        uint256 shareHi,
        uint256 prize,
        uint256 burned,
        bool first
    );
    event FeeUpdated(uint256 oldFee, uint256 newFee);
    event PrizeRecipientUpdated(address oldRecipient, address newRecipient);

    function setUp() public {
        nft = new MockChogs();
        token = new MockChogToken();
        // the mock collection holds token IDs 1..1969 like the real one; we mint the ones the tests use
        nft.mint(holderA, 1);
        nft.mint(holderB, 2);
        nft.mint(holderA, 3);
        nft.mint(holderB, 1969);
        reg = new ChogBreakRegistry(IERC721(address(nft)), IERC20(address(token)), MAX_FEE, FEE, prize, owner);
        for (uint256 i; i < 2; i++) {
            address u = i == 0 ? alice : bob;
            token.mint(u, 1_000_000e18);
        }
    }

    function _approveAndRecord(address who, uint256 a, uint256 b) internal returns (bool) {
        vm.startPrank(who);
        token.approve(address(reg), reg.fee()); // exact amount, never unlimited
        bool first = reg.recordSplice(a, b);
        vm.stopPrank();
        return first;
    }

    // ---------- pair key ----------

    function test_pairOrderNormalization() public {
        _approveAndRecord(alice, 2, 1);
        bytes32 k = keccak256(abi.encode(address(nft), uint256(1), uint256(2)));
        assertEq(reg.pairSpliceCount(k), 1);
        assertEq(reg.pairKeyOf(2, 1), k);
        assertEq(reg.pairKeyOf(1, 2), k);
    }

    function test_samePairSameKey() public view {
        assertEq(reg.pairKeyOf(3, 1969), reg.pairKeyOf(1969, 3));
        assertTrue(reg.pairKeyOf(1, 2) != reg.pairKeyOf(1, 3));
    }

    /// Shared fixture with the app (tests/fixtures/pairkey-vectors.json, generated by the TS core).
    function test_pairKeyVectorsMatchTypeScript() public {
        string memory json = vm.readFile("../tests/fixtures/pairkey-vectors.json");
        assertEq(json.readAddress(".collection"), REAL_CHOG_GENESIS);
        // a registry whose CHOG_GENESIS is the real collection address (mock code etched there)
        vm.etch(REAL_CHOG_GENESIS, address(nft).code);
        ChogBreakRegistry real =
            new ChogBreakRegistry(IERC721(REAL_CHOG_GENESIS), IERC20(address(token)), MAX_FEE, FEE, prize, owner);
        uint256 n;
        for (uint256 i;; i++) {
            string memory p = string.concat(".vectors[", vm.toString(i), "]");
            if (!vm.keyExistsJson(json, p)) break;
            uint256 lo = json.readUint(string.concat(p, ".lo"));
            uint256 hi = json.readUint(string.concat(p, ".hi"));
            bytes32 expected = json.readBytes32(string.concat(p, ".pairKey"));
            assertEq(real.pairKeyOf(lo, hi), expected, "vector");
            assertEq(real.pairKeyOf(hi, lo), expected, "reversed vector");
            n++;
        }
        assertGe(n, 6, "spec: >= 6 vectors");
    }

    // ---------- validation ----------

    function test_sameTokenRejected() public {
        vm.startPrank(alice);
        token.approve(address(reg), FEE);
        vm.expectRevert(ChogBreakRegistry.SameToken.selector);
        reg.recordSplice(7, 7);
        vm.stopPrank();
    }

    function test_nonexistentTokensRejectedViaOwnerOf() public {
        vm.startPrank(alice);
        token.approve(address(reg), FEE);
        vm.expectRevert(abi.encodeWithSelector(IERC721Errors.ERC721NonexistentToken.selector, 0));
        reg.recordSplice(0, 1);
        vm.expectRevert(abi.encodeWithSelector(IERC721Errors.ERC721NonexistentToken.selector, 1970));
        reg.recordSplice(1, 1970);
        vm.stopPrank();
    }

    // ---------- discovery ----------

    function test_firstDiscovererSetOnceAndTimeRecorded() public {
        vm.warp(1_760_000_000);
        bool first = _approveAndRecord(alice, 1, 2);
        assertTrue(first);
        bytes32 k = reg.pairKeyOf(1, 2);
        assertEq(reg.firstDiscoverer(k), alice);
        assertEq(reg.firstDiscoveryTime(k), 1_760_000_000);

        vm.warp(1_760_000_999);
        bool second = _approveAndRecord(bob, 2, 1);
        assertFalse(second);
        assertEq(reg.firstDiscoverer(k), alice, "discoverer never changes");
        assertEq(reg.firstDiscoveryTime(k), 1_760_000_000, "time never changes");
    }

    function test_secondSpliceIncrementsCount() public {
        _approveAndRecord(alice, 1, 2);
        bool first = _approveAndRecord(alice, 1, 2);
        assertFalse(first);
        assertEq(reg.pairSpliceCount(reg.pairKeyOf(1, 2)), 2);
        assertEq(reg.tokenUsageCount(1), 2);
        assertEq(reg.tokenUsageCount(2), 2);
        assertEq(reg.tokenUsageCount(3), 0);
    }

    // ---------- fee accounting ----------

    function test_payoutsExact() public {
        uint256 a0 = token.balanceOf(holderA);
        uint256 b0 = token.balanceOf(holderB);
        uint256 s0 = token.balanceOf(alice);
        _approveAndRecord(alice, 1, 2);
        assertEq(token.balanceOf(holderA) - a0, 35e18, "ownerLo 35%");
        assertEq(token.balanceOf(holderB) - b0, 35e18, "ownerHi 35%");
        assertEq(token.balanceOf(prize), 20e18, "prize 20%");
        assertEq(token.balanceOf(DEAD), 10e18, "dead address 10%");
        assertEq(s0 - token.balanceOf(alice), FEE, "splicer pays exactly the fee");
        assertEq(token.balanceOf(address(reg)), 0, "registry holds nothing");
        assertEq(reg.tokenEarned(1), 35e18);
        assertEq(reg.tokenEarned(2), 35e18);
    }

    function test_ownerLoPayout() public {
        _approveAndRecord(alice, 2, 3); // lo = 2 (holderB), hi = 3 (holderA)
        assertEq(token.balanceOf(holderB), 35e18);
    }

    function test_ownerHiPayout() public {
        _approveAndRecord(alice, 2, 3);
        assertEq(token.balanceOf(holderA), 35e18);
    }

    function test_sameOwnerReceivesBothShares() public {
        _approveAndRecord(alice, 1, 3); // holderA owns both
        assertEq(token.balanceOf(holderA), 70e18);
    }

    function test_prizeAllocation() public {
        _approveAndRecord(alice, 1, 2);
        assertEq(token.balanceOf(prize), FEE - 35e18 - 35e18 - 10e18);
    }

    function test_deadAddressAllocation() public {
        _approveAndRecord(alice, 1, 2);
        assertEq(token.balanceOf(DEAD), 10e18);
    }

    /// Odd fees: every wei is accounted for, the prize takes the rounding remainder.
    function testFuzz_oddFeeNoDust(uint256 f) public {
        f = bound(f, 0, MAX_FEE);
        vm.prank(owner);
        reg.setFee(f);
        uint256 s0 = token.balanceOf(alice);
        _approveAndRecord(alice, 1, 2);
        uint256 lo = token.balanceOf(holderA);
        uint256 hi = token.balanceOf(holderB);
        uint256 pz = token.balanceOf(prize);
        uint256 dd = token.balanceOf(DEAD);
        assertEq(lo + hi + pz + dd, f, "no dust");
        assertEq(s0 - token.balanceOf(alice), f);
        assertEq(lo, (f * 3500) / 10_000);
        assertEq(hi, lo);
        assertEq(dd, (f * 1000) / 10_000);
    }

    function test_oddFeeExample() public {
        vm.prank(owner);
        reg.setFee(7); // 7 wei: 2 + 2 + 0 dead, prize 3
        _approveAndRecord(alice, 1, 2);
        assertEq(token.balanceOf(holderA), 2);
        assertEq(token.balanceOf(holderB), 2);
        assertEq(token.balanceOf(DEAD), 0);
        assertEq(token.balanceOf(prize), 3);
    }

    function test_zeroFeePath() public {
        vm.prank(owner);
        reg.setFee(0);
        vm.prank(alice);
        bool first = reg.recordSplice(1, 2); // no approval needed, nothing moves
        assertTrue(first);
        assertEq(token.balanceOf(holderA), 0);
        assertEq(reg.pairSpliceCount(reg.pairKeyOf(1, 2)), 1);
    }

    function test_insufficientAllowanceFails() public {
        vm.startPrank(alice);
        token.approve(address(reg), FEE - 1);
        vm.expectRevert();
        reg.recordSplice(1, 2);
        vm.stopPrank();
        assertEq(reg.pairSpliceCount(reg.pairKeyOf(1, 2)), 0, "state rolled back");
    }

    function test_insufficientBalanceFails() public {
        address poor = makeAddr("poor");
        token.mint(poor, FEE - 1);
        vm.startPrank(poor);
        token.approve(address(reg), FEE);
        vm.expectRevert();
        reg.recordSplice(1, 2);
        vm.stopPrank();
    }

    /// A raised fee can't pull more than the exact amount the user approved.
    function test_feeRaiseAfterApprovalFails() public {
        vm.prank(alice);
        token.approve(address(reg), FEE);
        vm.prank(owner);
        reg.setFee(FEE * 2);
        vm.prank(alice);
        vm.expectRevert();
        reg.recordSplice(1, 2);
    }

    // ---------- security ----------

    function test_reentrancyViaMaliciousTokenFails() public {
        ReentrantToken evil = new ReentrantToken();
        ChogBreakRegistry r2 =
            new ChogBreakRegistry(IERC721(address(nft)), IERC20(address(evil)), MAX_FEE, FEE, prize, owner);
        evil.setTarget(IRecord(address(r2)));
        evil.mint(alice, 1_000e18);
        vm.startPrank(alice);
        evil.approve(address(r2), FEE * 2);
        vm.expectRevert(ReentrancyGuard.ReentrancyGuardReentrantCall.selector);
        r2.recordSplice(1, 3);
        vm.stopPrank();
    }

    /// Owners come from ownerOf at call time; nothing the caller passes can redirect a payout.
    function test_ownerCannotBeSpoofed() public {
        vm.prank(holderA);
        nft.transferFrom(holderA, bob, 1); // token 1 changes hands
        _approveAndRecord(alice, 1, 2);
        assertEq(token.balanceOf(bob), 1_000_000e18 + 35e18, "current owner is paid");
        assertEq(token.balanceOf(holderA), 0, "previous owner is not");
        assertEq(token.balanceOf(alice), 1_000_000e18 - FEE, "caller gets nothing back");
    }

    function test_pausedBlocksRecordSplice() public {
        vm.prank(owner);
        reg.pause();
        vm.startPrank(alice);
        token.approve(address(reg), FEE);
        vm.expectRevert(Pausable.EnforcedPause.selector);
        reg.recordSplice(1, 2);
        vm.stopPrank();
        vm.prank(owner);
        reg.unpause();
        _approveAndRecord(alice, 1, 2);
    }

    function test_onlyOwnerAdmin() public {
        bytes memory err = abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice);
        vm.startPrank(alice);
        vm.expectRevert(err);
        reg.setFee(1);
        vm.expectRevert(err);
        reg.setPrizeRecipient(alice);
        vm.expectRevert(err);
        reg.pause();
        vm.expectRevert(err);
        reg.unpause();
        vm.stopPrank();
    }

    function test_setFeeAboveMaxFails() public {
        vm.prank(owner);
        vm.expectRevert(abi.encodeWithSelector(ChogBreakRegistry.FeeTooHigh.selector, MAX_FEE + 1, MAX_FEE));
        reg.setFee(MAX_FEE + 1);
    }

    function test_constructorGuards() public {
        vm.expectRevert(ChogBreakRegistry.ZeroAddress.selector);
        new ChogBreakRegistry(IERC721(address(nft)), IERC20(address(token)), MAX_FEE, FEE, address(0), owner);
        vm.expectRevert(abi.encodeWithSelector(ChogBreakRegistry.FeeTooHigh.selector, MAX_FEE + 1, MAX_FEE));
        new ChogBreakRegistry(IERC721(address(nft)), IERC20(address(token)), MAX_FEE, MAX_FEE + 1, prize, owner);
    }

    function test_setPrizeRecipientRejectsZero() public {
        vm.prank(owner);
        vm.expectRevert(ChogBreakRegistry.ZeroAddress.selector);
        reg.setPrizeRecipient(address(0));
    }

    function test_ownershipIsTwoStep() public {
        vm.prank(owner);
        reg.transferOwnership(bob);
        assertEq(reg.owner(), owner, "not transferred until accepted");
        vm.prank(bob);
        reg.acceptOwnership();
        assertEq(reg.owner(), bob);
    }

    // ---------- events ----------

    function test_eventsCarryCorrectArgs() public {
        bytes32 k = reg.pairKeyOf(1, 2);
        vm.startPrank(alice);
        token.approve(address(reg), FEE);
        vm.expectEmit(true, true, true, true, address(reg));
        emit PairDiscovered(k, 1, 2, alice);
        vm.expectEmit(true, true, true, true, address(reg));
        emit SpliceRecorded(alice, alice, 1, 2, k, holderA, holderB, FEE, 35e18, 35e18, 20e18, 10e18, true);
        reg.recordSplice(2, 1);
        vm.stopPrank();

        vm.startPrank(bob);
        token.approve(address(reg), FEE);
        vm.expectEmit(true, true, true, true, address(reg));
        emit SpliceRecorded(bob, bob, 1, 2, k, holderA, holderB, FEE, 35e18, 35e18, 20e18, 10e18, false);
        reg.recordSplice(1, 2);
        vm.stopPrank();
    }

    function test_adminEvents() public {
        vm.startPrank(owner);
        vm.expectEmit(false, false, false, true, address(reg));
        emit FeeUpdated(FEE, 5e18);
        reg.setFee(5e18);
        vm.expectEmit(false, false, false, true, address(reg));
        emit PrizeRecipientUpdated(prize, bob);
        reg.setPrizeRecipient(bob);
        vm.stopPrank();
    }

    // ---------- v2: sponsored recordings ----------

    function test_sponsoredRecordCreditsPlayerAndRelayerPays() public {
        address player = makeAddr("player"); // holds no $CHOG and no MON
        address relayer = bob;
        bytes32 k = reg.pairKeyOf(1, 2);
        uint256 r0 = token.balanceOf(relayer);
        vm.startPrank(relayer);
        token.approve(address(reg), FEE); // exact
        vm.expectEmit(true, true, true, true, address(reg));
        emit PairDiscovered(k, 1, 2, player);
        vm.expectEmit(true, true, true, true, address(reg));
        emit SpliceRecorded(player, relayer, 1, 2, k, holderA, holderB, FEE, 35e18, 35e18, 20e18, 10e18, true);
        bool first = reg.recordSpliceFor(player, 2, 1);
        vm.stopPrank();
        assertTrue(first);
        assertEq(reg.firstDiscoverer(k), player, "the player, not the relayer, is the discoverer");
        assertEq(r0 - token.balanceOf(relayer), FEE, "relayer paid exactly the fee");
        assertEq(token.balanceOf(player), 0, "player paid nothing");
        assertEq(token.balanceOf(holderA), 35e18);
        assertEq(token.balanceOf(holderB), 35e18);
        assertEq(token.balanceOf(address(reg)), 0);
    }

    function test_sponsoredRecordRejectsZeroPlayer() public {
        vm.startPrank(bob);
        token.approve(address(reg), FEE);
        vm.expectRevert(ChogBreakRegistry.ZeroAddress.selector);
        reg.recordSpliceFor(address(0), 1, 2);
        vm.stopPrank();
    }

    function test_sponsoredRecordRespectsPauseAndSameToken() public {
        vm.startPrank(bob);
        token.approve(address(reg), FEE);
        vm.expectRevert(ChogBreakRegistry.SameToken.selector);
        reg.recordSpliceFor(alice, 3, 3);
        vm.stopPrank();
        vm.prank(owner);
        reg.pause();
        vm.prank(bob);
        vm.expectRevert(Pausable.EnforcedPause.selector);
        reg.recordSpliceFor(alice, 1, 2);
    }

    function test_sponsoredThenDirectKeepsFirstDiscoverer() public {
        address player = makeAddr("player");
        vm.startPrank(bob);
        token.approve(address(reg), FEE);
        reg.recordSpliceFor(player, 1, 2);
        vm.stopPrank();
        bool first = _approveAndRecord(alice, 1, 2);
        assertFalse(first);
        assertEq(reg.firstDiscoverer(reg.pairKeyOf(1, 2)), player);
        assertEq(reg.pairSpliceCount(reg.pairKeyOf(1, 2)), 2);
    }

    function test_sponsoredReentrancyFails() public {
        ReentrantToken evil = new ReentrantToken();
        ChogBreakRegistry r2 =
            new ChogBreakRegistry(IERC721(address(nft)), IERC20(address(evil)), MAX_FEE, FEE, prize, owner);
        evil.setTarget(IRecord(address(r2)));
        evil.mint(bob, 1_000e18);
        vm.startPrank(bob);
        evil.approve(address(r2), FEE * 2);
        vm.expectRevert(ReentrancyGuard.ReentrancyGuardReentrantCall.selector);
        r2.recordSpliceFor(alice, 1, 3);
        vm.stopPrank();
    }
}
