{
  "name": "chog-break",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:verify": "tsx scripts/verify-chain.ts",
    "data:manifest": "tsx scripts/build-manifest.ts",
    "data:report": "tsx scripts/trait-report.ts",
    "registry:verify": "tsx scripts/verify-registry.ts",
    "data:sprites": "tsx scripts/build-sprites.ts",
    "docs:check": "tsx scripts/docs-check.ts"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
